(* Expressions evaluated within checks and invariants *)
expression
    = implication;

implication
    = disjunction, [ "->", implication ];

disjunction
    = conjunction, { "||", conjunction };

conjunction
    = equality, { "&&", equality };

equality
    = comparison, { ( "=="
    | "!=" ), comparison };

comparison
    = membership, { ( ">"
    | ">="
    | "<"
    | "<=" ), membership };

membership
    = term, { ( "in"
    | "not", "in" ), term };

term
    = factor, { ( "+"
    | "-" ), factor };

factor
    = unary, { ( "*"
    | "/" ), unary };

unary
    = ( "!"
    | "-" ), unary
    | postfix;

(* TODO: Support array-indexing in lexer *)
postfix
    = primary, { ".", IDENTIFIER
    | "[", expression, "]" };

primary
    = literal
    | "this"
    | IDENTIFIER (* includes "value" *)
    | list
    | "(", expression, ")";

(* TODO: Collapse number/integer into single number in lexer, store as double *)
literal
    = NUMBER
    | STRING
    | "true"
    | "false"
    | "null";

list
    = "[", [ expression, { ",", expression } ], "]";